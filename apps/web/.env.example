# Backend API the frontend proxies /api/* to.
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080

# Base hostname REPL ingresses live under.
NEXT_PUBLIC_RUNNER_DOMAIN_NAME=localhost:8000

# The site's own public origin. REQUIRED in production.
#
# This is the base for canonical URLs, the sitemap and Open Graph tags. Left
# unset the app falls back to http://localhost:3000 and robots.txt switches to
# "Disallow: /" — correct for a preview deploy, wrong for production.
NEXT_PUBLIC_SITE_URL=https://devx.parthkapoor.me

# Optional: raises the Product Hunt badge's API rate limit.
PRODUCTHUNT_TOKEN=optional
