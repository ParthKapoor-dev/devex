# Environment variables (only the example files are committed)
.env
.env.*
*.env
.envrc
!.env.example

# Secrets and inventories, at any depth
**/secrets
**/hosts
*.kubeconfig
kubeconfig*

# Keys and certificates
*.pem
*.key
*.p12
id_rsa*
id_ed25519*

# Logs and temporary files
*.log
*/tmp/
*/workspaces/
